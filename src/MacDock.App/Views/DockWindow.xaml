<Window x:Class="MacDock.App.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:MacDock.App.Behaviors"
        Title="MacDock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        UseLayoutRounding="True">

    <!-- Fully transparent pixels of a layered window are click-through, so only the plate and
         icons catch the mouse; the headroom above them never blocks the apps underneath. -->
    <Grid x:Name="Root">
        <Grid x:Name="DockArea"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="0,0,0,6"
              MouseMove="OnDockMouseMove"
              MouseLeave="OnDockMouseLeave"
              PreviewMouseMove="OnDockPreviewMouseMove"
              PreviewMouseLeftButtonUp="OnDockMouseUp"
              LostMouseCapture="OnDockLostCapture">

            <!-- Invisible (alpha 1) hover zone, enabled only while hovering: lets the cursor travel
                 up over magnified icons without "leaving" the dock through the gaps between them. -->
            <Border x:Name="HoverZone" Background="{x:Null}" />

            <Border x:Name="Plate"
                    VerticalAlignment="Bottom"
                    Height="66"
                    CornerRadius="18"
                    BorderThickness="1"
                    BorderBrush="#55FFFFFF"
                    Background="#B3262629">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Quit MacDock" Click="OnQuitClick" />
                    </ContextMenu>
                </Border.ContextMenu>
            </Border>

            <ItemsControl x:Name="Icons"
                          ItemsSource="{Binding Items}"
                          VerticalAlignment="Bottom"
                          Margin="9,0,9,9">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- The dot hangs below the icon (negative margin) into the plate's bottom padding. -->
                        <Grid Margin="4,0" VerticalAlignment="Bottom" ClipToBounds="False">
                            <Button x:Name="IconButton"
                                    Command="{Binding ClickCommand}"
                                    ToolTip="{Binding DisplayName}"
                                    Width="{Binding Size}"
                                    Height="{Binding Size}"
                                    VerticalAlignment="Bottom"
                                    Cursor="Hand"
                                    Focusable="False"
                                    PreviewMouseLeftButtonDown="OnIconMouseDown"
                                    behaviors:BounceBehavior.IsEnabled="True">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Image Source="{Binding IconTarget, Converter={StaticResource TargetToIcon}}"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Stretch="Uniform" />
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding NewWindowCommand}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Header" Value="Open" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Header" Value="New window" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <MenuItem Command="{Binding TogglePinCommand}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Header" Value="Pin to Dock" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                            <Setter Property="Header" Value="Unpin from Dock" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <Separator Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                        <MenuItem Header="Quit"
                                                  Command="{Binding QuitCommand}"
                                                  Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Ellipse Width="4" Height="4"
                                     Fill="#E6FFFFFF"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,-7"
                                     IsHitTestVisible="False"
                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</Window>
