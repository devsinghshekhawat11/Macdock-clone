<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>MacDock</AssemblyName>
    <RootNamespace>MacDock.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- No MacDock.exe: run as "dotnet MacDock.dll". Smart App Control blocks unsigned, locally built
         exes, but the Microsoft-signed dotnet host can load our IL-only assemblies. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MacDock.Core\MacDock.Core.csproj" />
    <ProjectReference Include="..\MacDock.Interop\MacDock.Interop.csproj" />
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
